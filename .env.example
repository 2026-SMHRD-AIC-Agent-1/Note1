# ============================================================
# 환경 변수 템플릿 (.env.example)
# ------------------------------------------------------------
# 이 파일은 "어떤 설정값이 필요한지" 보여주는 견본입니다.
# 실제 값을 채운 뒤 파일명을 .env 로 바꿔서 사용하세요.
# .env 파일은 절대 Git에 커밋하지 마세요 (.gitignore에 이미 포함됨).
# ============================================================

# --- 데이터베이스 ---
# 기본값은 로컬 SQLite 파일. PostgreSQL로 옮길 때 예시:
# DATABASE_URL=postgresql://user:password@localhost:5432/interview_db
DATABASE_URL=sqlite:///./app.db

# 콘솔에 실행되는 SQL 로그를 보여줄지 여부 (개발 중엔 true 추천)
SQL_ECHO=true

# --- Frontend 연동 (CORS) ---
# Frontend 개발 서버 주소를 쉼표로 구분해서 여러 개 넣을 수 있습니다.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 외부 AI API 키 (RAG·언어 AI 담당이 실제로 연동할 때 사용) ---
# 아직 사용하는 코드가 없다면 비워둬도 됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- RAG 원문 자료 경로 (재명씨 AI연동규격 v0.1 "10. 환경변수·설치" 참고) ---
# Colab의 /content/drive/... 경로가 아니라, 이 서버(내 컴퓨터)에서 실제로
# 접근 가능한 절대/상대 경로로 지정해야 합니다. 02/03/04/05/07로 시작하는
# 자료 파일과 PDF만 RAG 원문으로 읽어들입니다.
RAG_DATA_DIR=./rag_data

# --- 답변 녹화 파일 업로드 (routers/uploads.py) ---
# 업로드된 음성/영상 파일이 저장될 폴더 (uploads/audio, uploads/video 하위 생성)
UPLOAD_DIR=./uploads
RAG_DEFAULT_COMPANY=SK하이닉스
RAG_DEFAULT_JOB=System Architecture / Software Solution

# --- 기타 (필요해지면 팀과 상의 후 추가) ---
# SECRET_KEY=
