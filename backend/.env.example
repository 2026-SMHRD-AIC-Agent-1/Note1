# ============================================================
# 환경 변수 템플릿 (.env.example)
# ------------------------------------------------------------
# 이 파일은 "어떤 설정값이 필요한지" 보여주는 견본입니다.
# 실제 값을 채운 뒤 파일명을 .env 로 바꿔서 사용하세요.
# .env 파일은 절대 Git에 커밋하지 마세요 (.gitignore에 이미 포함됨).
# ============================================================

# --- 데이터베이스 ---
# 기본값은 로컬 SQLite 파일. PostgreSQL로 옮길 때 예시:
# DATABASE_URL=postgresql://user:password@localhost:3000/interview_db
DATABASE_URL=sqlite:///./app.db

# 콘솔에 실행되는 SQL 로그를 보여줄지 여부 (개발 중엔 true 추천)
SQL_ECHO=true

# --- Frontend 연동 (CORS) ---
# Frontend 개발 서버 주소를 쉼표로 구분해서 여러 개 넣을 수 있습니다.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 외부 AI API 키 (RAG·언어 AI + STT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- RAG 원문 자료 경로 ---
RAG_DATA_DIR=C:\Users\smhrd\Desktop\Note1\backend\rag_data
RAG_DEFAULT_COMPANY=SK하이닉스
RAG_DEFAULT_JOB=System Architecture / Software Solution

# --- 미디어/STT ---
MEDIA_STORAGE_DIR=./uploads
MAX_AUDIO_BYTES=26214400
MAX_VIDEO_BYTES=209715200

# 일반 서비스용 최종 텍스트 STT. 기존 동작과 호환됩니다.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 45개 파일럿/안정성 분석용 상세 STT.
# word/segment timestamp를 위해 verbose_json을 지원하는 whisper-1을 사용합니다.
OPENAI_TRANSCRIBE_DETAIL_MODEL=whisper-1

# --- 기타 (필요해지면 팀과 상의 후 추가) ---
# SECRET_KEY=
